# 思忆集环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# .env 文件在启动时自动加载，优先级低于系统环境变量

# DeepSeek / OpenAI 兼容 API
SIYI_LLM_API_KEY=sk-your-api-key-here
SIYI_LLM_BASE_URL=https://api.deepseek.com/v1
SIYI_LLM_MODEL=deepseek-chat

# 备用 API（当主 API 不可用时自动回退）
# SIYI_LLM_FALLBACK_API_KEY=sk-your-fallback-key
# SIYI_LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# SIYI_LLM_FALLBACK_MODEL=gpt-4o-mini

# 本地模型（Ollama）
# SIYI_LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# SIYI_LLM_LOCAL_MODEL=qwen3-4b

# Automation Hub 后端连接（桌面端智能体依赖）
# SIYI_AUTOMATION_HUB_API_BASE=http://localhost:8000
# SIYI_AUTOMATION_HUB_API_TOKEN=your-api-token-here

# 火山引擎（仅供 思忆集app/glm_proxy.py 使用 — Anthropic 协议代理）
# 缺失时 glm_proxy 启动会立即报错
# VOLC_API_KEY=ark-your-volc-key-here

# 火山引擎 ARK Key（仅供 .scripts/generate_xiaowen_sprites.py 桌宠动作帧生成使用）
# 缺失时脚本立即报错退出；密钥不得写回源码
# ARK_API_KEY=ark-your-ark-key-here

# 桌面 ↔ 手机 transfer 鉴权（缺省时禁用 transfer 端点的鉴权 — 仅推荐 LAN 内可信环境）
# SIYI_TRANSFER_KEY=generate-a-random-32-char-string

