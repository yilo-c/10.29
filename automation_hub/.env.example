# ═══════════════════════════════════════════════════════════════════
# Automation Hub 环境变量参考
# 策略分类: [C] 编译期  [R] 运行期  [S] 密钥
# ═══════════════════════════════════════════════════════════════════
# 使用方式:
#   1. 复制为 .env 文件: cp .env.example .env
#   2. 修改其中的值
#   3. pydantic-settings 会在 Settings() 初始化时自动加载 .env
# ═══════════════════════════════════════════════════════════════════

# ── [C] 项目元信息 ──────────────────────────────────────────────
# 编译期确定，随镜像发布。一般不通过 .env 覆写。
# APP_NAME=Automation Hub
# VERSION=0.1.0

# ── [R] 环境标识 ─────────────────────────────────────────────────
# 可选值: development, staging, production
# ENVIRONMENT=development

# ── [R] 服务绑定 ─────────────────────────────────────────────────
# 本地模式建议 127.0.0.1；远端由反向代理暴露
# HOST=127.0.0.1
# PORT=8000

# ── [R] 目录与路径 ──────────────────────────────────────────────
# 默认值基于 BASE_DIR (automation-hub/ 目录)
# DATA_DIR=
# WORKSPACE_DIR=
# SCRIPTS_DIR=
# DATABASE_PATH=          # 默认: {DATA_DIR}/automation_hub.sqlite3
# RUNS_DIR=               # 默认: {DATA_DIR}/runs
# LOGS_DIR=               # 默认: {DATA_DIR}/logs

# ── [R] 产物保留治理 ────────────────────────────────────────────
# 设为 0 表示不启用自动清理。生产建议按需求设置（如 14 天 / 30 天）。
# RUN_ARTIFACT_RETENTION_DAYS=0
# PROPOSAL_ARTIFACT_RETENTION_DAYS=0
# ARTIFACT_CLEANER_INTERVAL_SECONDS=3600

# ── [R] Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=default

# ── [R] Token 生命周期 ──────────────────────────────────────────
# 0 表示不启用默认过期；生产建议 30-90 天
# TOKEN_DEFAULT_TTL_DAYS=0

# ── [R] 审批超时 ────────────────────────────────────────────────
# 0 表示不启用自动过期；生产建议 86400 (24h)
# APPROVAL_TTL_SECONDS=0
# APPROVAL_EXPIRER_INTERVAL_SECONDS=60

# ── [R] Agent ──────────────────────────────────────────────────
# AGENT_ENABLED=false

# ── [R] Docker Executor ────────────────────────────────────────
# DOCKER_EXECUTOR_IMAGE=automation-hub:latest
# DOCKER_EXECUTOR_NETWORK=none
# DOCKER_EXECUTOR_ALLOW_HOST_FALLBACK=true
# DOCKER_EXECUTOR_SOCK_PATH=/var/run/docker.sock
# DOCKER_EXECUTOR_PREFLIGHT_PULL=true
# DOCKER_EXECUTOR_PREFLIGHT_TIMEOUT_SECONDS=5

# ── [R/S] 通知 (SMTP) ─────────────────────────────────────────
# SMTP_PASSWORD 属 [S] 类，建议通过 Secret 注入而非 .env 文件
# NOTIFICATION_ENABLED=false
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=          # [S] 建议通过 Secret 注入
# SMTP_FROM=
# SMTP_TO=

# ── [R/S] 通知 (Webhook / Telegram) ───────────────────────────
# WEBHOOK_URL=
# TELEGRAM_TOKEN=         # [S]
# TELEGRAM_CHAT_ID=

# ── [R] 调度器 ──────────────────────────────────────────────────
# SCHEDULER_ENABLED=false
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_MAX_WORKERS=3

# ── [R] 文件监控 ────────────────────────────────────────────────
# WATCHER_ENABLED=false
# WATCHER_PATHS=
# WATCHER_IGNORE_PATTERNS=*.pyc,__pycache__,.git,.venv,node_modules
