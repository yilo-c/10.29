{
  "name": "desk-notes",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5175\" \"wait-on http://localhost:5175 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "pnpm --filter @desk-notes/desktop electron:build",
    "typecheck:desktop": "pnpm --filter @desk-notes/desktop run typecheck",
    "test": "pnpm --filter @desk-notes/desktop run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sync": "node scripts/sync-dist.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^5.1.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.desk-notes.app",
    "productName": "思忆便签",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "思忆便签-便携版-${version}.exe"
    }
  }
}
