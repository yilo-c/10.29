{
  "name": "@desk-notes/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "思忆便签 - 轻量级浮动便签与待办管理",
  "author": "siyi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"vite --port 5190\" \"wait-on http://127.0.0.1:5190 && cross-env NODE_ENV=development electron . --no-sandbox\"",
    "generate-icons": "node scripts/generate-icons.cjs",
    "electron:build": "npm run generate-icons && vite build && electron-builder",
    "pet:xiaowen:qa": "..\\..\\..\\.venv3.11\\Scripts\\python.exe scripts/xiaowen_minimal_assets.py",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@desk-notes/shared": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "@uiw/react-md-editor": "~3.4.0",
    "dompurify": "^3.2.6",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.0.0",
    "fuse.js": "^7.3.0",
    "katex": "^0.16.0",
    "lucide-react": "^1.30.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.10",
    "mermaid": "^11.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.desk-notes.app",
    "productName": "思忆便签",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "electronVersion": "42.0.0",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "思忆便签",
      "artifactName": "desk-notes-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "思忆便签-便携版-${version}.exe"
    },
    "extraResources": [
      {
        "from": "../../使用说明.md",
        "to": "使用说明.md"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "siyi",
      "repo": "desk-notes",
      "releaseType": "release"
    }
  }
}
