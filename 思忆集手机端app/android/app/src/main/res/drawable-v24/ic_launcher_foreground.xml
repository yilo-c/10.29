<?xml version="1.0" encoding="utf-8"?>
<!--
  思忆便签 自适应图标 —— 前景层

  设计语言参考小米笔记：极简、大留白、少量彩色点缀。
  但做出区分：小米用「三行列表」，这里用「交叉线条 + 圆点」，
  呼应"思忆集"的"集"（汇聚、交织），同时保持列表的阅读隐喻。

  安全性说明：自适应图标前景必须留出安全区（中央 66dp / 108dp 见方），
  否则在圆形、圆角方形、squircle 等不同裁切形状下会被切掉。
  本图所有可见元素都控制在 66dp 安全区内。

  色彩：
    - 主线：#3B82F6（蓝，与小米笔记的蓝点同色系但更深）
    - 次线：#93C5FD（浅蓝，表达"记忆的层次"）
    - 点缀：#FF9500（橙，呼应小米笔记的橙点）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主线条：从左上到右下的长笔画（象征"记下"的动作） -->
    <path
        android:pathData="M38,42 L70,42"
        android:strokeColor="#3B82F6"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- 第二条：短一些，形成节奏感 -->
    <path
        android:pathData="M38,54 L60,54"
        android:strokeColor="#93C5FD"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- 第三条：最短，收尾 -->
    <path
        android:pathData="M38,66 L52,66"
        android:strokeColor="#93C5FD"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- 左侧圆点（列表符号），橙色点缀，与小米笔记的橙点呼应 -->
    <path
        android:fillColor="#FF9500"
        android:pathData="M30,42 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />

    <!-- 右侧交叉元素：表达"集"（汇聚） -->
    <path
        android:pathData="M74,50 L82,58 M82,50 L74,58"
        android:strokeColor="#3B82F6"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55" />
</vector>
